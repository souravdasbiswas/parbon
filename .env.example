# ---- Server ----
# Hostinger injects PORT automatically; 5000 is used locally.
PORT=5000
NODE_ENV=development

# Public URL of the site (used for canonical links, sitemap.xml and robots.txt)
SITE_URL=http://localhost:5173

# Optional Hostinger safety settings.
# PARBON_SITE overrides the site detected from /home/<user>/domains/<site>/...
# and selects ~/parbon.<site>.env when it exists.
# PARBON_PRIMARY_SITES may list the only sites allowed to fall back to ~/parbon.env.
# SITE_NOINDEX defaults to true in production when SITE_URL is not one of those primary sites.
# PARBON_SITE=
# PARBON_PRIMARY_SITES=parbon.in,www.parbon.in
# SITE_NOINDEX=

# Comma-separated list of allowed origins for the API (only needed if the
# frontend is served from a different domain than the API).
CORS_ORIGINS=

# Set to 1 when running behind Hostinger's proxy so rate limiting sees real client IPs.
TRUST_PROXY=1

# ---- Email (optional) ----
# Used for enquiry notifications to MAIL_TO and, for coupons, to email people their coupon links.
# If SMTP_HOST is empty, enquiries are still saved and coupons are shared by link / WhatsApp only.
# Hostinger email: smtp.hostinger.com, port 465, secure=true, the mailbox address as SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Parbon Sanskritik Samity <no-reply@example.org>"
MAIL_TO=committee@example.org

# ---- Admin (announcements) ----
# Generate the hash + secret with:  npm run admin:hash -- "a-strong-password"
# The plain password is never stored. Leave empty to disable admin sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_HOURS=8

# ---- Coupon gate scanner (optional) ----
# Gate volunteers are added by the admin under Admin → Gate team (username + PIN); admins can always scan.
# How long a volunteer stays signed in on their phone:
SCANNER_SESSION_HOURS=16

# ---- Persistent runtime data (recommended on Hostinger) ----
# Point these OUTSIDE the deployment folder so redeploys never wipe
# admin-created announcements, uploaded images or saved enquiries.
# STORAGE_DIR=/home/<user>/parbon-data/storage
# MEDIA_DIR=/home/<user>/parbon-data/media

# ---- MySQL / MariaDB (recommended on Hostinger: hPanel → Databases) ----
# When DB_NAME and DB_USER are set, announcements, form responses and uploaded
# images are stored in the database (tables are created automatically) and survive redeploys.
# Leave DB_NAME empty to use the files above. Never commit the password.
# On Hostinger the host is 127.0.0.1 (the default); avoid "localhost", which can resolve to IPv6.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional: extra old app folders (comma-separated) to import once into the database. Earlier
# Hostinger deployments (…/hbuilds/versions/<id>/nodejs) are found automatically.
# LEGACY_IMPORT_DIRS=
